{
  "$comment": [
    "5言語（Ruby / TypeScript / Dart / Kotlin）のドメイン関数が同じ答えを返すことを保証する唯一の期待値。",
    "サーバへロジックを移すとき、この JSON を全言語のテストが読むことで挙動のズレを機械的に検出する。",
    "ケースを追加したら、全実装のテストが通ることを CI で確認すること。",
    "日付は 'YYYY-MM-DD'。2026-08-01=土, 2026-08-02=日, 2026-08-03=月。"
  ],
  "streak": {
    "$comment": "calculateStreak(logs, today) -> { current, longest, lastCompletedDate }。skipped 以外を実施日として数え、最終実施日が今日か昨日なら継続。",
    "cases": [
      {
        "name": "記録が無ければ0",
        "today": "2026-08-05",
        "logs": [],
        "expect": {
          "current": 0,
          "longest": 0,
          "lastCompletedDate": null
        }
      },
      {
        "name": "今日まで連続していれば日数を数える",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-03",
            "status": "completed"
          },
          {
            "log_date": "2026-08-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2026-08-05"
        }
      },
      {
        "name": "今日まだ実施していなくても昨日やっていれば継続扱い",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-03",
            "status": "completed"
          },
          {
            "log_date": "2026-08-04",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 2,
          "longest": 2,
          "lastCompletedDate": "2026-08-04"
        }
      },
      {
        "name": "2日以上空いていればストリークは切れる",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-01",
            "status": "completed"
          },
          {
            "log_date": "2026-08-02",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 0,
          "longest": 2,
          "lastCompletedDate": "2026-08-02"
        }
      },
      {
        "name": "同じ日に複数ルーティンをやっても1日として数える",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 2,
          "longest": 2,
          "lastCompletedDate": "2026-08-05"
        }
      },
      {
        "name": "中断(skipped)はストリークに数えない",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "skipped"
          }
        ],
        "expect": {
          "current": 1,
          "longest": 1,
          "lastCompletedDate": "2026-08-04"
        }
      },
      {
        "name": "全種目やりきれなかった日(partial)もストリークは途切れない",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "partial"
          }
        ],
        "expect": {
          "current": 2,
          "longest": 2,
          "lastCompletedDate": "2026-08-05"
        }
      },
      {
        "name": "過去の最長ストリークを保持する",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-07-01",
            "status": "completed"
          },
          {
            "log_date": "2026-07-02",
            "status": "completed"
          },
          {
            "log_date": "2026-07-03",
            "status": "completed"
          },
          {
            "log_date": "2026-07-04",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 1,
          "longest": 4,
          "lastCompletedDate": "2026-08-05"
        }
      },
      {
        "name": "ログの順序が入れ替わっていても結果は同じ",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-05",
            "status": "completed"
          },
          {
            "log_date": "2026-08-03",
            "status": "completed"
          },
          {
            "log_date": "2026-08-04",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2026-08-05"
        }
      },
      {
        "name": "月をまたいでも連続として数える",
        "today": "2026-08-02",
        "logs": [
          {
            "log_date": "2026-07-31",
            "status": "completed"
          },
          {
            "log_date": "2026-08-01",
            "status": "completed"
          },
          {
            "log_date": "2026-08-02",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2026-08-02"
        }
      },
      {
        "name": "うるう年の2月末をまたいでも連続として数える",
        "today": "2028-03-01",
        "logs": [
          {
            "log_date": "2028-02-28",
            "status": "completed"
          },
          {
            "log_date": "2028-02-29",
            "status": "completed"
          },
          {
            "log_date": "2028-03-01",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2028-03-01"
        }
      },
      {
        "name": "DST開始日(欧州3月末)をまたいでも1日として数える",
        "today": "2026-03-30",
        "logs": [
          {
            "log_date": "2026-03-28",
            "status": "completed"
          },
          {
            "log_date": "2026-03-29",
            "status": "completed"
          },
          {
            "log_date": "2026-03-30",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2026-03-30"
        }
      },
      {
        "name": "DST終了日(欧州10月末)をまたいでも1日として数える",
        "today": "2026-10-26",
        "logs": [
          {
            "log_date": "2026-10-24",
            "status": "completed"
          },
          {
            "log_date": "2026-10-25",
            "status": "completed"
          },
          {
            "log_date": "2026-10-26",
            "status": "completed"
          }
        ],
        "expect": {
          "current": 3,
          "longest": 3,
          "lastCompletedDate": "2026-10-26"
        }
      },
      {
        "name": "skippedしか無ければ0",
        "today": "2026-08-05",
        "logs": [
          {
            "log_date": "2026-08-04",
            "status": "skipped"
          },
          {
            "log_date": "2026-08-05",
            "status": "skipped"
          }
        ],
        "expect": {
          "current": 0,
          "longest": 0,
          "lastCompletedDate": null
        }
      }
    ]
  },
  "dueToday": {
    "$comment": "isRoutineDueToday(routine, lastLog, today) -> Boolean。「今日やる予定か」だけを見る。「今日もう終わったか」は別判定。frequency_days は 日=0..土=6。",
    "cases": [
      {
        "name": "停止中のルーティンは対象外",
        "today": "2026-08-01",
        "routine": {
          "is_active": false,
          "frequency_type": "daily",
          "frequency_value": 1,
          "frequency_days": []
        },
        "lastLog": null,
        "expect": false
      },
      {
        "name": "毎日のルーティンは常に対象",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "daily",
          "frequency_value": 1,
          "frequency_days": []
        },
        "lastLog": {
          "log_date": "2026-07-31",
          "status": "completed"
        },
        "expect": true
      },
      {
        "name": "N日ごと: 間隔を満たせば対象",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "every_n_days",
          "frequency_value": 3,
          "frequency_days": []
        },
        "lastLog": {
          "log_date": "2026-07-29",
          "status": "completed"
        },
        "expect": true
      },
      {
        "name": "N日ごと: 間隔を満たさなければ対象外",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "every_n_days",
          "frequency_value": 3,
          "frequency_days": []
        },
        "lastLog": {
          "log_date": "2026-07-30",
          "status": "completed"
        },
        "expect": false
      },
      {
        "name": "N日ごと: 一度も実施していなければ今日から始められる",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "every_n_days",
          "frequency_value": 7,
          "frequency_days": []
        },
        "lastLog": null,
        "expect": true
      },
      {
        "name": "N日ごと: frequency_value が 0 でも 1 として扱う",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "every_n_days",
          "frequency_value": 0,
          "frequency_days": []
        },
        "lastLog": {
          "log_date": "2026-07-31",
          "status": "completed"
        },
        "expect": true
      },
      {
        "name": "曜日指定: 今日の曜日が含まれる(土=6)",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            6
          ]
        },
        "lastLog": null,
        "expect": true
      },
      {
        "name": "曜日指定: 今日の曜日が含まれない",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            1,
            3
          ]
        },
        "lastLog": null,
        "expect": false
      },
      {
        "name": "曜日指定: 日曜は 0 として扱う",
        "today": "2026-08-02",
        "routine": {
          "is_active": true,
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            0
          ]
        },
        "lastLog": null,
        "expect": true
      },
      {
        "name": "曜日指定: 月曜は 1 として扱う",
        "today": "2026-08-03",
        "routine": {
          "is_active": true,
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            1
          ]
        },
        "lastLog": null,
        "expect": true
      },
      {
        "name": "曜日指定: 曜日が未設定なら毎日扱い",
        "today": "2026-08-01",
        "routine": {
          "is_active": true,
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": []
        },
        "lastLog": null,
        "expect": true
      }
    ]
  },
  "dailyStats": {
    "$comment": "calculateDailyStats(logs, days, today) -> [{ date, completedCount, totalCount }]。古い順。記録の無い日も0で埋める。",
    "cases": [
      {
        "name": "記録の無い日も0で埋めて古い順に返す",
        "today": "2026-08-05",
        "days": 3,
        "logs": [
          {
            "log_date": "2026-08-05",
            "status": "completed"
          },
          {
            "log_date": "2026-08-03",
            "status": "completed"
          }
        ],
        "expect": [
          {
            "date": "2026-08-03",
            "completedCount": 1,
            "totalCount": 1
          },
          {
            "date": "2026-08-04",
            "completedCount": 0,
            "totalCount": 0
          },
          {
            "date": "2026-08-05",
            "completedCount": 1,
            "totalCount": 1
          }
        ]
      },
      {
        "name": "partial は実施した日として数える",
        "today": "2026-08-05",
        "days": 1,
        "logs": [
          {
            "log_date": "2026-08-05",
            "status": "partial"
          }
        ],
        "expect": [
          {
            "date": "2026-08-05",
            "completedCount": 1,
            "totalCount": 1
          }
        ]
      },
      {
        "name": "skipped は実施に数えないが件数には入る",
        "today": "2026-08-05",
        "days": 1,
        "logs": [
          {
            "log_date": "2026-08-05",
            "status": "skipped"
          }
        ],
        "expect": [
          {
            "date": "2026-08-05",
            "completedCount": 0,
            "totalCount": 1
          }
        ]
      },
      {
        "name": "同じ日に複数ある場合はそれぞれ数える",
        "today": "2026-08-05",
        "days": 1,
        "logs": [
          {
            "log_date": "2026-08-05",
            "status": "completed"
          },
          {
            "log_date": "2026-08-05",
            "status": "skipped"
          }
        ],
        "expect": [
          {
            "date": "2026-08-05",
            "completedCount": 1,
            "totalCount": 2
          }
        ]
      },
      {
        "name": "月をまたいでも日付が連続する",
        "today": "2026-08-01",
        "days": 3,
        "logs": [
          {
            "log_date": "2026-07-30",
            "status": "completed"
          }
        ],
        "expect": [
          {
            "date": "2026-07-30",
            "completedCount": 1,
            "totalCount": 1
          },
          {
            "date": "2026-07-31",
            "completedCount": 0,
            "totalCount": 0
          },
          {
            "date": "2026-08-01",
            "completedCount": 0,
            "totalCount": 0
          }
        ]
      }
    ]
  },
  "exerciseProgress": {
    "$comment": "calculateExerciseProgress(exerciseId, routineLogs, exerciseLogs) -> [{ date, maxWeight, totalReps, totalVolume }]。日付の古い順。自重(weight=null)は0として扱う。",
    "cases": [
      {
        "name": "日付ごとに最大重量・総回数・総ボリュームを集計する",
        "exerciseId": "ex1",
        "routineLogs": [
          {
            "id": "log-a",
            "log_date": "2026-08-01",
            "status": "completed"
          },
          {
            "id": "log-b",
            "log_date": "2026-08-03",
            "status": "completed"
          }
        ],
        "exerciseLogs": [
          {
            "routine_log_id": "log-a",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 10,
            "actual_weight": 60
          },
          {
            "routine_log_id": "log-a",
            "exercise_id": "ex1",
            "set_number": 2,
            "actual_reps": 8,
            "actual_weight": 65
          },
          {
            "routine_log_id": "log-b",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 10,
            "actual_weight": 70
          },
          {
            "routine_log_id": "log-b",
            "exercise_id": "ex2",
            "set_number": 1,
            "actual_reps": 12,
            "actual_weight": 20
          }
        ],
        "expect": [
          {
            "date": "2026-08-01",
            "maxWeight": 65,
            "totalReps": 18,
            "totalVolume": 1120
          },
          {
            "date": "2026-08-03",
            "maxWeight": 70,
            "totalReps": 10,
            "totalVolume": 700
          }
        ]
      },
      {
        "name": "対象の種目が無ければ空",
        "exerciseId": "none",
        "routineLogs": [
          {
            "id": "log-a",
            "log_date": "2026-08-01",
            "status": "completed"
          }
        ],
        "exerciseLogs": [],
        "expect": []
      },
      {
        "name": "自重種目は重量0として扱う",
        "exerciseId": "ex1",
        "routineLogs": [
          {
            "id": "log-a",
            "log_date": "2026-08-01",
            "status": "completed"
          }
        ],
        "exerciseLogs": [
          {
            "routine_log_id": "log-a",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 10,
            "actual_weight": null
          },
          {
            "routine_log_id": "log-a",
            "exercise_id": "ex1",
            "set_number": 2,
            "actual_reps": 10,
            "actual_weight": 50
          }
        ],
        "expect": [
          {
            "date": "2026-08-01",
            "maxWeight": 50,
            "totalReps": 20,
            "totalVolume": 500
          }
        ]
      },
      {
        "name": "親ログが存在しないセット記録は無視する",
        "exerciseId": "ex1",
        "routineLogs": [
          {
            "id": "log-a",
            "log_date": "2026-08-01",
            "status": "completed"
          }
        ],
        "exerciseLogs": [
          {
            "routine_log_id": "log-a",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 10,
            "actual_weight": 50
          },
          {
            "routine_log_id": "missing",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 99,
            "actual_weight": 99
          }
        ],
        "expect": [
          {
            "date": "2026-08-01",
            "maxWeight": 50,
            "totalReps": 10,
            "totalVolume": 500
          }
        ]
      }
    ]
  },
  "overallStats": {
    "$comment": "calculateOverallStats(routineLogs, exerciseLogs, today) -> { totalWorkouts, totalDurationSec, totalSets, thisWeekCount }。thisWeekCount は今日を含む直近7日。",
    "cases": [
      {
        "name": "直近7日の回数を含めて集計する",
        "today": "2026-08-05",
        "routineLogs": [
          {
            "log_date": "2026-08-05",
            "status": "completed",
            "duration_sec": 600
          },
          {
            "log_date": "2026-08-01",
            "status": "completed",
            "duration_sec": 600
          },
          {
            "log_date": "2026-07-01",
            "status": "completed",
            "duration_sec": 600
          }
        ],
        "exerciseLogs": [
          {
            "routine_log_id": "x",
            "exercise_id": "ex1",
            "set_number": 1,
            "actual_reps": 10,
            "actual_weight": 50
          }
        ],
        "expect": {
          "totalWorkouts": 3,
          "totalDurationSec": 1800,
          "totalSets": 1,
          "thisWeekCount": 2
        }
      },
      {
        "name": "skipped は通算にも今週にも数えない",
        "today": "2026-08-05",
        "routineLogs": [
          {
            "log_date": "2026-08-05",
            "status": "skipped",
            "duration_sec": 10
          },
          {
            "log_date": "2026-08-05",
            "status": "partial",
            "duration_sec": 300
          }
        ],
        "exerciseLogs": [],
        "expect": {
          "totalWorkouts": 1,
          "totalDurationSec": 300,
          "totalSets": 0,
          "thisWeekCount": 1
        }
      },
      {
        "name": "7日前ちょうどは今週に含む",
        "today": "2026-08-05",
        "routineLogs": [
          {
            "log_date": "2026-07-30",
            "status": "completed",
            "duration_sec": 100
          }
        ],
        "exerciseLogs": [],
        "expect": {
          "totalWorkouts": 1,
          "totalDurationSec": 100,
          "totalSets": 0,
          "thisWeekCount": 1
        }
      },
      {
        "name": "8日前は今週に含まない",
        "today": "2026-08-05",
        "routineLogs": [
          {
            "log_date": "2026-07-29",
            "status": "completed",
            "duration_sec": 100
          }
        ],
        "exerciseLogs": [],
        "expect": {
          "totalWorkouts": 1,
          "totalDurationSec": 100,
          "totalSets": 0,
          "thisWeekCount": 0
        }
      }
    ]
  },
  "formatDuration": {
    "$comment": "formatDuration(seconds) -> String。null は '--:--'。1時間以上で h:mm:ss。",
    "cases": [
      {
        "name": "0秒",
        "seconds": 0,
        "expect": "0:00"
      },
      {
        "name": "1分5秒",
        "seconds": 65,
        "expect": "1:05"
      },
      {
        "name": "1時間2分5秒",
        "seconds": 3725,
        "expect": "1:02:05"
      },
      {
        "name": "ちょうど1時間",
        "seconds": 3600,
        "expect": "1:00:00"
      },
      {
        "name": "59分59秒",
        "seconds": 3599,
        "expect": "59:59"
      },
      {
        "name": "null",
        "seconds": null,
        "expect": "--:--"
      },
      {
        "name": "負の値は0として扱う",
        "seconds": -5,
        "expect": "0:00"
      }
    ]
  },
  "formatWeight": {
    "$comment": "formatWeight(weight) -> String。null は '-- kg'。小数第1位まで、.0 は省く。",
    "cases": [
      {
        "name": "整数",
        "weight": 60,
        "expect": "60 kg"
      },
      {
        "name": "小数第1位あり",
        "weight": 62.5,
        "expect": "62.5 kg"
      },
      {
        "name": "0",
        "weight": 0,
        "expect": "0 kg"
      },
      {
        "name": "null",
        "weight": null,
        "expect": "-- kg"
      }
    ]
  },
  "formatFrequency": {
    "$comment": "formatFrequency(routine) -> String。移行後はサーバが返す文字列。",
    "cases": [
      {
        "name": "毎日",
        "routine": {
          "frequency_type": "daily",
          "frequency_value": 1,
          "frequency_days": []
        },
        "expect": "毎日"
      },
      {
        "name": "3日ごと",
        "routine": {
          "frequency_type": "every_n_days",
          "frequency_value": 3,
          "frequency_days": []
        },
        "expect": "3日ごと"
      },
      {
        "name": "1日ごとは毎日と表示",
        "routine": {
          "frequency_type": "every_n_days",
          "frequency_value": 1,
          "frequency_days": []
        },
        "expect": "毎日"
      },
      {
        "name": "曜日指定は日曜始まりで並べる",
        "routine": {
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            3,
            1
          ]
        },
        "expect": "月・水"
      },
      {
        "name": "曜日指定で日曜を含む",
        "routine": {
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": [
            6,
            0
          ]
        },
        "expect": "日・土"
      },
      {
        "name": "曜日が未設定なら毎日",
        "routine": {
          "frequency_type": "weekly",
          "frequency_value": 1,
          "frequency_days": []
        },
        "expect": "毎日"
      }
    ]
  },
