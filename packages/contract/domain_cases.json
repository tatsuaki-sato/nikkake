  "formatPreviousSets": {
    "description": "ワークアウト画面の「前回: …」に出す文字列。重量は format_weight と同じ丸め（小数第1位、.0 は省く）で、単位は付けない。時間計測の種目は秒だけを出す。自重は「自重」と書く",
    "cases": [
      {
        "name": "記録なし",
        "sets": [],
        "expect": ""
      },
      {
        "name": "重量つき1セット",
        "sets": [
          {
            "set_number": 1,
            "reps": 10,
            "weight": 50,
            "duration_sec": null
          }
        ],
        "expect": "50×10"
      },
      {
        "name": "整数の重量に .0 を付けない",
        "sets": [
          {
            "set_number": 1,
            "reps": 10,
            "weight": 50.0,
            "duration_sec": null
          }
        ],
        "expect": "50×10"
      },
      {
        "name": "小数の重量は第1位まで",
        "sets": [
          {
            "set_number": 1,
            "reps": 8,
            "weight": 62.5,
            "duration_sec": null
          }
        ],
        "expect": "62.5×8"
      },
      {
        "name": "第2位以下は丸める",
        "sets": [
          {
            "set_number": 1,
            "reps": 8,
            "weight": 62.46,
            "duration_sec": null
          }
        ],
        "expect": "62.5×8"
      },
      {
        "name": "複数セットは / でつなぐ",
        "sets": [
          {
            "set_number": 1,
            "reps": 10,
            "weight": 50,
            "duration_sec": null
          },
          {
            "set_number": 2,
            "reps": 9,
            "weight": 50,
            "duration_sec": null
          }
        ],
        "expect": "50×10 / 50×9"
      },
      {
        "name": "重量なしは自重",
        "sets": [
          {
            "set_number": 1,
            "reps": 15,
            "weight": null,
            "duration_sec": null
          }
        ],
        "expect": "自重×15"
      },
      {
        "name": "回数不明はハイフン",
        "sets": [
          {
            "set_number": 1,
            "reps": null,
            "weight": null,
            "duration_sec": null
          }
        ],
        "expect": "自重×-"
      },
      {
        "name": "時間計測は秒だけ",
        "sets": [
          {
            "set_number": 1,
            "reps": null,
            "weight": null,
            "duration_sec": 30
          }
        ],
        "expect": "30秒"
      },
      {
        "name": "時間計測は重量より優先する",
        "sets": [
          {
            "set_number": 1,
            "reps": 10,
            "weight": 50,
            "duration_sec": 30
          }
        ],
        "expect": "30秒"
      },
      {
        "name": "時間と重量の種目が混ざる",
        "sets": [
          {
            "set_number": 1,
            "reps": null,
            "weight": null,
            "duration_sec": 30
          },
          {
            "set_number": 2,
            "reps": 10,
            "weight": 40,
            "duration_sec": null
          }
        ],
        "expect": "30秒 / 40×10"
      }
    ]
  }
}
